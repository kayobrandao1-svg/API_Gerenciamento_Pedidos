{
  "info": {
    "name": "API de Gerenciamento de Pedidos",
    "description": "Cenários manuais dos endpoints obrigatórios. Execute a API local antes de usar a coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Criar pedido válido (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pedidos"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.collectionVariables.set('pedidoId', pm.response.json().id);"] } }]
    },
    {
      "name": "02 - Dados inválidos (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"entrega\",\n  \"valor\": 0,\n  \"prioridade\": \"normal\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pedidos"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "03 - Listar pedidos (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.test('Resposta é uma lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"] } }]
    },
    {
      "name": "04 - Consultar ID inexistente (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/pedidos/99999" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 404', function () { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "05 - Atualizar status para em_preparacao (200)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"em_preparacao\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.test('Status atualizado', function () { pm.expect(pm.response.json().status).to.eql('em_preparacao'); });"] } }]
    }
  ]
}
